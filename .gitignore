# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/
.DS_Store

# Trained weights and training state: rebuilt by the drivers of scripts/.
checkpoints/
*.pt
*.pth
*.ptop
*.pkl

# Datasets: rebuilt by src/prepare_data.py from the raw solver output.
# data/mesh_stub.h5 is the one exception -- the plotting-grid fallback, needed offline.
*.h5
!data/mesh_stub.h5
data/*.pt
cache/

# Run outputs: metrics, logs and step markers are regenerated by scripts/.
results/
logs/
*.log
.done_*

# Figures: every plot here is the output of a driver, never a committed asset.
# Force one in with `git add -f <file>` if it ever becomes documentation.
*.pdf
*.png
